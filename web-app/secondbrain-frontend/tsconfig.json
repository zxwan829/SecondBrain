{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@blocksuite/data-view/view-presets": ["./node_modules/@blocksuite/data-view/dist/view-presets/index.d.ts"],
      "@blocksuite/data-view/property-presets": ["./node_modules/@blocksuite/data-view/dist/property-presets/index.d.ts"],
      "@blocksuite/data-view/widget-presets": ["./node_modules/@blocksuite/data-view/dist/widget-presets/index.d.ts"],
      "@blocksuite/data-view/effects": ["./node_modules/@blocksuite/data-view/dist/effects.d.ts"],
      "@blocksuite/affine/store": ["./node_modules/@blocksuite/store/dist/index.d.ts"],
      "@blocksuite/*/store": ["./node_modules/@blocksuite/*/dist/store.d.ts"],
      "@blocksuite/*/view": ["./node_modules/@blocksuite/*/dist/view.d.ts"],
      "@blocksuite/*/adapters": ["./node_modules/@blocksuite/*/dist/adapters/index.d.ts"],
      "@blocksuite/*/test": ["./node_modules/@blocksuite/*/dist/test.d.ts"],
      "@blocksuite/*/services": ["./node_modules/@blocksuite/*/dist/services/index.d.ts"],
      "@blocksuite/*/utils": ["./node_modules/@blocksuite/*/dist/utils/index.d.ts"],
      "@blocksuite/*/di": ["./node_modules/@blocksuite/*/dist/di/index.d.ts"],
      "@blocksuite/*/disposable": ["./node_modules/@blocksuite/*/dist/disposable/index.d.ts"],
      "@blocksuite/*/event": ["./node_modules/@blocksuite/*/dist/event/index.d.ts"],
      "@blocksuite/*/inline": ["./node_modules/@blocksuite/*/dist/inline/index.d.ts"],
      "@blocksuite/std/effects": ["./node_modules/@blocksuite/std/dist/effects.d.ts"],
      "@blocksuite/global/env": ["./node_modules/@blocksuite/global/dist/env/index.d.ts"],
      "@blocksuite/global/exceptions": ["./node_modules/@blocksuite/global/dist/exceptions/index.d.ts"],
      "@blocksuite/global/gfx": ["./node_modules/@blocksuite/global/dist/gfx/index.d.ts"],
      "@blocksuite/global/lit": ["./node_modules/@blocksuite/global/dist/lit/index.d.ts"],
      "@blocksuite/global/types": ["./node_modules/@blocksuite/global/dist/types/index.d.ts"],
      "@blocksuite/std/gfx": ["./node_modules/@blocksuite/std/dist/gfx/index.d.ts"],
      "@blocksuite/*": ["./node_modules/@blocksuite/*/dist/index.d.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src"]
}
