{
  "name": "secondbrain-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "vitest run",
    "start:app": "cd ../secondbrain-core && python3 -m secondbrain_core",
    "package:test-plugin": "npm run build && node scripts/package-test-plugin.mjs",
    "package:review-bundle": "node scripts/package-review-bundle.mjs",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:fe25": "node scripts/verify-fe25.mjs"
  },
  "dependencies": {
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-table-cell": "3.32.0",
    "@tiptap/extension-table-header": "3.32.0",
    "@tiptap/extension-table-row": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "jsdom": "30.1.2",
    "vitest": "5.0.4"
  }
}
