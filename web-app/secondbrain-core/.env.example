# Runtime values only. Keep all credential files outside the source tree.
SB_REVIEW_ROOT=/data/SecondBrain/10-Review
SB_CAPTURE_RAW_ROOT=/data/KnowledgeAssets/00-Inbox
SB_KNOWLEDGE_ROOT=/data/SecondBrain/20-Knowledge
SB_PROMOTE_STATE_ROOT=/var/lib/secondbrain-core
SB_APP_PASSWORD_FILE=/run/secrets/secondbrain_app_password
SB_DASHBOARD_ORIGINS=http://192.168.3.27:9119,https://zxwan520.com:63012
SB_CORE_ALLOWED_HOSTS=192.168.3.27,zxwan520.com
# DSM HTTPS requests use only the verified proxy peer; do not add ranges or wildcards.
SB_TRUSTED_PROXY_IPS=172.18.0.1
SB_HERMES_API_URL=http://hermes:8642
SB_HERMES_API_KEY_FILE=/run/secrets/hermes_api_server_key
SB_PROMOTE_ENABLED=false
# Optional Organizer adapter wiring. Both switches stay disabled by default;
# model opt-in never starts the persistent scheduler by itself.
SB_ORGANIZER_MODEL_ENABLED=false
SB_ORGANIZER_SCHEDULER_ENABLED=false
SB_ORGANIZER_MODEL=deepseek-ai/DeepSeek-V4-Flash
# Only set this to an absolute, private secret-file path after separate approval.
SB_ORGANIZER_API_KEY_FILE=
SB_APP_SESSION_TTL=28800
PORT=8000
