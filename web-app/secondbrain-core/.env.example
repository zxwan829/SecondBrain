# Runtime values only. Keep all credential files outside the source tree.
SB_REVIEW_ROOT=/data/SecondBrain/10-Review
SB_KNOWLEDGE_ROOT=/data/SecondBrain/20-Knowledge
SB_PROMOTE_STATE_ROOT=/var/lib/secondbrain-core
SB_APP_PASSWORD_FILE=/run/secrets/secondbrain_app_password
SB_DASHBOARD_ORIGINS=http://192.168.3.27:9119,https://zxwan520.com:63012
SB_CORE_ALLOWED_HOSTS=192.168.3.27,zxwan520.com
# Set only after measuring the actual reverse-proxy peer; leave unset for direct local HTTP.
# SB_TRUSTED_PROXY_IPS=<verified DSM proxy peer IP>
SB_HERMES_API_URL=http://secondbrain-hermes:8642
SB_HERMES_API_KEY_FILE=/run/secrets/hermes_api_server_key
SB_PROMOTE_ENABLED=false
SB_APP_SESSION_TTL=28800
PORT=8000
