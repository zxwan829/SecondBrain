-async def _download_bytes(session: aiohttp.ClientSession, *, url: str, timeout_seconds: float = 60.0) -> bytes:
+MAX_INBOUND_MEDIA_BYTES = 128 * 1024 * 1024
+_MEDIA_DOWNLOAD_CHUNK_BYTES = 64 * 1024
+
+
+async def _download_bytes(
+    session: aiohttp.ClientSession, *, url: str, timeout_seconds: float = 60.0,
+    max_bytes: int = MAX_INBOUND_MEDIA_BYTES,
+) -> bytes:
+    if max_bytes < 0:
+        raise ValueError("max_bytes must be non-negative")
+
     async def _do() -> bytes:
         async with session.get(url) as response:
             response.raise_for_status()
-            return await response.read()
+            content_length = response.headers.get("Content-Length")
+            if content_length is not None:
+                if not isinstance(content_length, str) or re.fullmatch(r"[0-9]+", content_length) is None:
+                    raise ValueError("Weixin media has an invalid Content-Length")
+                declared_length = int(content_length)
+                if declared_length < 0 or declared_length > max_bytes:
+                    raise ValueError("Weixin media exceeds the configured download limit")
+
+            chunks: list[bytes] = []
+            total = 0
+            async for chunk in response.content.iter_chunked(_MEDIA_DOWNLOAD_CHUNK_BYTES):
+                total += len(chunk)
+                if total > max_bytes:
+                    raise ValueError("Weixin media exceeds the configured download limit")
+                chunks.append(chunk)
+            return b"".join(chunks)
     return await asyncio.wait_for(_do(), timeout=timeout_seconds)
 
 
